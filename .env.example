# --- Discord (required) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register slash commands to this server only (instant). Leave empty to register globally.
DISCORD_GUILD_ID=

# --- Recording ---
# Where sessions (audio + manifests) are stored. Mount a persistent volume here in Dokploy.
DATA_DIR=./data
# Leave the voice channel after it has been empty (no humans) for this many minutes.
EMPTY_CHANNEL_TIMEOUT_MIN=2
# Optional: only members with this role (or Manage Server) can start/stop/pause recordings.
RECORDER_ROLE_ID=
# Optional: path to the ffmpeg binary (defaults to "ffmpeg" on PATH).
FFMPEG_PATH=ffmpeg

# --- Processing (transcribe → summarize after each recording) ---
# Both use the de facto standard "OpenAI-compatible" HTTP APIs, which most hosted services and
# self-hosted servers speak. Point BASE_URL at any of them; API_KEY can stay empty for local servers.
# Provider: none (off) | mock (offline placeholder, for testing) | openai-compatible
STT_PROVIDER=none
# e.g. http://whisper:8000/v1 for a self-hosted Whisper server on the same Dokploy network
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=en
# verbose_json gives per-line timestamps; use json for models that only support that
STT_RESPONSE_FORMAT=verbose_json

# Provider: none (transcript only) | mock | openai-compatible
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# json_object asks the server for JSON output; use none if it rejects response_format
LLM_JSON_MODE=json_object
# Optional; leave empty to use the model's default (some models only accept their default)
LLM_TEMPERATURE=
# Transcript characters per LLM call; longer meetings are summarized in parts and combined
LLM_CHUNK_CHARS=48000

# --- Notion (optional) ---
# Internal integration secret (notion.so/profile/integrations). Then run /meeting setup in Discord.
NOTION_TOKEN=
# Save files and links posted in the voice channel's chat during a meeting.
# Needs "Message Content Intent" enabled in the Discord developer portal first.
COLLECT_CHAT_MATERIALS=false

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
