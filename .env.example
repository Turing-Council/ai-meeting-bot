# --- Discord (required) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register slash commands to this server only (instant). Leave empty to register globally.
DISCORD_GUILD_ID=

# --- Recording ---
# Where sessions (audio + manifests) are stored. Mount a persistent volume here in Dokploy.
DATA_DIR=./data
# Leave the voice channel after it has been empty (no humans) for this many minutes.
EMPTY_CHANNEL_TIMEOUT_MIN=2
# Optional: only members with this role (or Manage Server) can start/stop/pause recordings.
RECORDER_ROLE_ID=
# Optional: path to the ffmpeg binary (defaults to "ffmpeg" on PATH).
FFMPEG_PATH=ffmpeg

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
