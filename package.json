{
  "name": "turing-voice-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot that records voice meetings and logs them to Notion",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "register": "tsx --env-file-if-exists=.env src/scripts/register-commands.ts",
    "register:prod": "node dist/scripts/register-commands.js",
    "process": "tsx --env-file-if-exists=.env src/scripts/process-session.ts",
    "process:prod": "node dist/scripts/process-session.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
